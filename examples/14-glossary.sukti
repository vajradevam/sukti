// ---- core operations ------------------------------------------------------
// Add a new entry (returns the new size).
kriyA joDa(saMskRRitam, A~nglam, hindI, vibhAga) {
    kosha.prakShepa({
        "sa": saMskRRitam,
        "en": A~nglam,
        "hi": hindI,
        "tag": vibhAga
    });
    phalam kosha.dairghya();
}

// Find the first entry whose Sanskrit, English or Hindi headword matches.
kriyA khoja(shabda) {
    pratyekam praviShTiH antaH kosha {
        yadi (praviShTiH["sa"] == shabda) { phalam praviShTiH; }
        yadi (praviShTiH["en"] == shabda) { phalam praviShTiH; }
        yadi (praviShTiH["hi"] == shabda) { phalam praviShTiH; }
    }
    phalam shUnya;
}

// Count entries carrying a given tag.
kriyA gaNanA(vibhAga) {
    astu na = 0;
    pratyekam praviShTiH antaH kosha {
        yadi (praviShTiH["tag"] == vibhAga) { na = na + 1; }
    }
    phalam na;
}

// Return a list of all headwords for a tag.
kriyA sUchIbaddha(vibhAga) {
    astu pariNAma = [];
    pratyekam praviShTiH antaH kosha {
        yadi (praviShTiH["tag"] == vibhAga) { pariNAma.prakShepa(praviShTiH["sa"]); }
    }
    phalam pariNAma;
}

// Pretty-print one entry.
kriyA darshaya(praviShTiH) {
    yadi (praviShTiH == shUnya) {
        vada("na prAptam / not found");
        phalam shUnya;
    }
    vada(praviShTiH["sa"] + "  |  " + praviShTiH["en"] + "  |  " + praviShTiH["hi"] + "  |  " + praviShTiH["tag"]);
    phalam satya;
}

// Print all tags with their counts.
kriyA sAMkhyikI() {
    vada("-- sAMkhyikI / statistics --");
    vada(" nature    : " + gaNanA("nature"));
    vada(" study    : " + gaNanA("study"));
    vada(" abstract : " + gaNanA("abstract"));
    vada(" place    : " + gaNanA("place"));
    vada(" society  : " + gaNanA("society"));
    vada(" kula / total: " + kosha.dairghya());
}

// Save and load using the JSON stdlib.
kriyA rakSha() {
    astu pATha = su.nirmANa(kosha);
    su.lekhana("/tmp/sukti-glossary.json", pATha);
    phalam pATha.dairghya();
}

// ---- demonstration / smoke test ------------------------------------------
vada("=== bahubhAShI-koshaH / bilingual glossary ===");
vada("prArambhe / initially: " + kosha.dairghya() + " entries");

vada("");
vada("-- khoja / search --");
darshaya(khoja("agni"));
darshaya(khoja("book"));
darshaya(khoja("nAsti"));

vada("");
vada("-- navIna praviShTiH / add --");
vada("after add: " + joDa("kamala", "lotus", "kamala", "nature"));
darshaya(khoja("kamala"));

vada("");
vada("-- vibhAga-sUchI / tag listing --");
vada(sUchIbaddha("abstract"));

vada("");
sAMkhyikI();

vada("");
vada("-- saMrakShaNa / persistence --");
vada("json bytes: " + rakSha());
vada("file exists: " + su.astitva("/tmp/sukti-glossary.json"));

vada("");
vada("-- transliteration / rUpAntaraNa --");
vada(saMskRRita.rUpAntaraNa("vidyA", "itrans", "hk"));
vada(saMskRRita.rUpAntaraNa("vidyA", "itrans", "itrans"));
vada("=== samAptam / done ===");
